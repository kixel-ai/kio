def warm_settle.Relay.next_pulls
  {N : Std.Usize} (self : warm_settle.Relay N) :
  Result ((Option Std.U8) × (Option Std.U8))
  := do
  let b ← warm_settle.Relay.demand self
  if b
  then
    let (o, u, x) ←
      match self.next with
      | none => ok (none, self.up, none)
      | some x1 =>
        do
        let p ← warm_settle.Relay.pull self x1
        let (o1, o2) ←
          match p with
          | warm_settle.Pull.Live => ok (self.next, none)
          | warm_settle.Pull.Looped => ok (self.up, none)
          | warm_settle.Pull.Lost => ok (self.up, none)
          | warm_settle.Pull.Pending => ok (self.up, self.next)
        ok (self.next, o1, o2)
    warm_settle.Relay.decide { self with next := o } u x
  else ok (none, none)

