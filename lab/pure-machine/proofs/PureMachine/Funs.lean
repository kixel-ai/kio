/-- [kio_pure_machine::warm_settle::{kio_pure_machine::warm_settle::Relay<N>}::options]:
    Source: 'lab/pure-machine/src/warm_settle.rs', lines 238:4-278:5
    Visibility: public -/
def warm_settle.Relay.options
  {N : Std.Usize} (self : warm_settle.Relay N) (u : Option Std.U8) :
  Result (alloc.vec.Vec warm_settle.Choice)
  := do
  let mine ← warm_settle.Relay.mine self
  let (o, choices) ←
    match self.route with
    | none => ok (none, alloc.vec.Vec.new warm_settle.Choice)
    | some p =>
      do
      let (hop, cost) := p
      let b ← warm_settle.Relay.down self hop
      let v ←
        if b
        then ok (alloc.vec.Vec.new warm_settle.Choice)
        else
          alloc.vec.Vec.push (alloc.vec.Vec.new warm_settle.Choice)
            ({ via := hop, cost, copy := false, rank := warm_settle.NO_RANK } :
            warm_settle.Choice)
      ok (self.route, v)
  warm_settle.Relay.options_loop self.id self.reader o self.links self.heard
    self.up self.next self.answered u mine choices 1#u8

/-- [kio_pure_machine::warm_settle::toward]:
    Source: 'lab/pure-machine/src/warm_settle.rs', lines 317:0-323:1 -/
def warm_settle.toward
  (u : Std.U8) (x : Option Std.U8) (t : Option Std.U8) :
  Result ((Option Std.U8) × (Option Std.U8))
  := do
  match t with
  | none => ok (some u, none)
  | some t1 =>
    if t1 = u
    then ok (some u, none)
    else
      let b ← warm_settle.is x t1
      if b
      then ok (some u, x)
      else ok (some u, t)

/-- [kio_pure_machine::warm_settle::{kio_pure_machine::warm_settle::Relay<N>}::decide]:
    Source: 'lab/pure-machine/src/warm_settle.rs', lines 283:4-297:5 -/
def warm_settle.Relay.decide
  {N : Std.Usize} (self : warm_settle.Relay N) (u : Option Std.U8)
  (x : Option Std.U8) :
  Result ((Option Std.U8) × (Option Std.U8))
  := do
  let choices ← warm_settle.Relay.options self u
  let s := alloc.vec.Vec.deref choices
  let o ← warm_settle.best s
  let best ←
    match o with
    | none => ok none
    | some choice => ok (some choice.via)
  match u with
  | none => ok (best, none)
  | some u1 =>
    let p ← warm_settle.Relay.pull self u1
    match p with
    | warm_settle.Pull.Live =>
      let b := core.option.Option.is_some best
      if b
      then warm_settle.toward u1 x best
      else ok (best, none)
    | warm_settle.Pull.Looped => ok (best, none)
    | warm_settle.Pull.Lost => ok (best, none)
    | warm_settle.Pull.Pending =>
      let b ← warm_settle.is best u1
      if b
      then ok (u, x)
      else ok (best, none)

/-- [kio_pure_machine::warm_settle::{kio_pure_machine::warm_settle::Relay<N>}::next_pulls]:
    Source: 'lab/pure-machine/src/warm_settle.rs', lines 300:4-313:5
