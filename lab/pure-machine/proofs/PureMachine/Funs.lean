def warm_settle.Relay.pull
  {N : Std.Usize} (self : warm_settle.Relay N) (s : Std.U8) :
  Result warm_settle.Pull
  := do
  let h ← warm_settle.Relay.impl.heard self s
  match h.answer with
  | warm_settle.Answer.None =>
    let i ← warm_settle.bit s
    let i1 ← lift (self.answered &&& i)
    if i1 != 0#u16
    then ok warm_settle.Pull.Lost
    else ok warm_settle.Pull.Pending
  | warm_settle.Answer.Wait =>
    let i ← warm_settle.bit s
    let i1 ← lift (self.answered &&& i)
    if i1 != 0#u16
    then ok warm_settle.Pull.Lost
    else ok warm_settle.Pull.Pending
  | warm_settle.Answer.Live sig =>
    let i ← warm_settle.bit self.id
    let i1 ← lift (sig.path &&& i)
    if i1 = 0#u16
    then ok warm_settle.Pull.Live
    else ok warm_settle.Pull.Looped
  | warm_settle.Answer.Lost => ok warm_settle.Pull.Lost

